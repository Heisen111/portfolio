# Copy this file to `.env` (project root — same directory as this file) and
# fill in your own Groq API key. Never commit the real `.env`.
#
# The key is read ONLY by the Vercel serverless function (api/chat.ts) on the
# server. It is never bundled into the client, and the frontend never sees it.

GROQ_API_KEY=GROQ_API_KEY_HERE

# Model is server-configurable so it can change without touching application
# code. Currently the approved portfolio model.
GROQ_MODEL=openai/gpt-oss-120b